# Copy to `.env` for local development. On Railway, set these in the
# service's Variables tab instead. NEVER commit a real .env.

NODE_ENV=production
PORT=3000
# Public origin, used to build Stripe return links. e.g. https://courtdesk.app
APP_URL=

# ── Database ─────────────────────────────────────────────────
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave unset locally to use the built-in PGlite database in ./.pglite
DATABASE_URL=
# Set to true only if your Postgres requires SSL from outside Railway's network.
PGSSL=false

# ── Secrets — generate each ONCE, then never change them ──────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Exactly 64 hex chars. Encrypts each academy's Stripe keys.
# Changing it after academies connect Stripe makes their keys unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Your platform subscription (academies pay YOU monthly) ───
# From YOUR Stripe account. Create a Product with a monthly recurring Price.
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_PRICE_ID=
# Webhook endpoint: <APP_URL>/api/platform/webhook
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted
PLATFORM_STRIPE_WEBHOOK_SECRET=
# Shown on the academy's Billing page, e.g. "$49 / month"
PLATFORM_PRICE_LABEL=
TRIAL_DAYS=14
PLATFORM_NAME=CourtDesk

# ── Operator console (/platform) ─────────────────────────────
# A separate login for you — not an academy account.
# Hash: node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 12))"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
